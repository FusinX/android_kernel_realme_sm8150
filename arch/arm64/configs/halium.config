#
# halium.config — Halium 11 / Ubuntu Touch config fragment
# Target device : Realme X2 Pro (samurai) — SM8150 / sdm855
# Kernel        : Linux 4.14 (LineageOS 21 base)
# Base defconfig: arch/arm64/configs/samurai_defconfig  (DO NOT MODIFY)
#
# PURPOSE
#   This file is a config fragment that adds every option required for
#   Halium 11 and Ubuntu Touch that is either missing from, or explicitly
#   disabled in, samurai_defconfig.  It contains NO duplicates — every
#   line here either overrides an explicit "not set" in the base, or adds
#   something that was absent entirely.
#
# HOW TO BUILD
#   From the kernel source root, run:
#
#     scripts/kconfig/merge_config.sh \
#         arch/arm64/configs/samurai_defconfig \
#         arch/arm64/configs/halium.config
#
#   This writes a merged .config.  Then build normally:
#     make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc) Image.gz-dtb
#
#   Or use the convenience wrapper (if present in your tree):
#     ./build.sh halium
#
# ITEMS IN THIS FILE  (38 total)
#   - 5  explicit overrides  (options disabled in samurai that Halium needs ON)
#   - 31 additions           (options absent from samurai that Halium needs)
#   - 2  security overrides  (default LSM flip: SELinux → AppArmor)
#
# Options confirmed already present in samurai_defconfig that need no change:
#   CONFIG_TUN, CONFIG_VETH, CONFIG_BRIDGE, CONFIG_INPUT_EVDEV,
#   CONFIG_INPUT_UINPUT, CONFIG_BLK_DEV_LOOP, CONFIG_OVERLAY_FS,
#   CONFIG_FUSE_FS, CONFIG_EXT4_FS, CONFIG_F2FS_FS, CONFIG_SECCOMP,
#   CONFIG_ANDROID_BINDER_IPC, CONFIG_ANDROID_BINDERFS, CONFIG_DM_CRYPT,
#   CONFIG_DM_VERITY, CONFIG_ZRAM, CONFIG_IKCONFIG, CONFIG_NAMESPACES,
#   CONFIG_CGROUP_FREEZER, CONFIG_CPUSETS, CONFIG_MEMCG, CONFIG_MODULES,
#   CONFIG_SECURITY_SELINUX, CONFIG_SECURITY_SMACK, CONFIG_TMPFS_POSIX_ACL
#

# ============================================================
# SECTION 1 — GENERAL SETUP
# 5 items: 2 overrides, 3 additions
# ============================================================

# OVERRIDE: explicitly set to "not set" in samurai_defconfig line 3
# systemd >= 183 uses the name_to_handle_at() syscall for inotify.
# Without this, systemd's journald and unit tracking silently break.
CONFIG_FHANDLE=y

# ADDITION: not present in samurai_defconfig
# POSIX message queues are used by systemd's socket activation and
# several Ubuntu Touch background services (e.g. location, ofono).
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ADDITION: not present in samurai_defconfig
# Required by LXC for container checkpoint/restore functionality and
# by some cgroup-v1 operations used in the Halium container config.
CONFIG_CHECKPOINT_RESTORE=y

# OVERRIDE: explicitly set to "not set" in samurai_defconfig line 5
# AppArmor policy enforcement and systemd's audit integration both
# require AUDITSYSCALL.  AppArmor's audit rules silently do nothing
# if this is missing.
CONFIG_AUDITSYSCALL=y

# ============================================================
# SECTION 2 — NAMESPACES
# 4 items: 1 override, 3 additions
# ============================================================
# CONFIG_NAMESPACES=y already in samurai.
# CONFIG_UTS_NS — not listed in samurai but auto-selected by NAMESPACES.
# CONFIG_NET_NS — not listed in samurai but auto-selected by NET+NAMESPACES.

# ADDITION: not present in samurai_defconfig
# IPC_NS depends on SYSVIPC (set above) and is required so the LXC
# Android container gets an isolated IPC namespace, preventing
# Android's Binder/ashmem IDs from leaking into the Ubuntu Touch side.
CONFIG_IPC_NS=y

# ADDITION: not present in samurai_defconfig
# LXC unprivileged container mode requires user namespaces.  Ubuntu
# Touch's app confinement (click packages, Mir sandboxing) also uses
# USER_NS for the per-app namespace isolation layer.
CONFIG_USER_NS=y

# OVERRIDE: explicitly set to "not set" in samurai_defconfig line 32
# PID_NS is required by LXC to give the Android container PID 1
# isolation.  Without it, LXC will refuse to start the container.
CONFIG_PID_NS=y

# ============================================================
# SECTION 3 — CGROUPS
# 2 items: both additions
# ============================================================
# CONFIG_CGROUPS, MEMCG, CGROUP_SCHED, CGROUP_FREEZER, CPUSETS,
# CGROUP_CPUACCT, BLK_CGROUP, CGROUP_BPF already in samurai.

# ADDITION: not present in samurai_defconfig
# systemd uses the device cgroup controller to restrict /dev access
# inside service units.  The LXC Android container config explicitly
# requires it to whitelist the GPU, camera, and audio devices.
CONFIG_CGROUP_DEVICE=y

# ADDITION: not present in samurai_defconfig
# systemd >= 219 requires the PID controller to implement per-service
# process count limits.  Halium's LXC config also requests it for
# tracking Android container PID counts.
CONFIG_CGROUP_PIDS=y

# ============================================================
# SECTION 4 — DEVTMPFS  (udev will not start without this)
# 2 items: both additions
# ============================================================

# ADDITION: not present in samurai_defconfig
# devtmpfs instructs the kernel to populate /dev before userspace
# starts.  systemd-udevd requires it and will hard-fail at boot if
# absent.  This is the single most common Ubuntu Touch boot failure
# on Android-based kernels.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ============================================================
# SECTION 5 — VIRTUAL TERMINAL
# 6 items: 1 override + 5 additions
# ============================================================

# OVERRIDE: explicitly set to "not set" in samurai_defconfig line 364
# Ubuntu Touch's Mir display server, adb shell, SSH, and systemd's
# console getty all require a working virtual terminal (VT) layer.
# This was disabled in samurai for Android (which doesn't need VT).
CONFIG_VT=y

# ADDITIONS: these sub-options become available once VT=y
# In most kernels they are auto-selected, but they are listed here
# explicitly to ensure merge_config.sh does not leave them unset.
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_DUMMY_CONSOLE=y

# ============================================================
# SECTION 6 — BINARY FORMATS
# 1 item: addition
# ============================================================

# ADDITION: not present in samurai_defconfig
# binfmt_misc is required by Ubuntu Touch's click-package tooling
# for running architecture-translated binaries, and by some Halium
# test infrastructure scripts.
CONFIG_BINFMT_MISC=y

# ============================================================
# SECTION 7 — FILESYSTEMS
# 7 items: 1 override + 6 additions
# ============================================================
# CONFIG_EXT4_FS, CONFIG_F2FS_FS, CONFIG_FUSE_FS, CONFIG_OVERLAY_FS,
# CONFIG_ECRYPT_FS, CONFIG_MSDOS_FS, CONFIG_VFAT_FS, CONFIG_TMPFS_POSIX_ACL
# already in samurai.

# OVERRIDE: explicitly set to "not set" in samurai_defconfig line 36
# XZ-compressed initramfs support.  Halium boot images frequently
# use XZ for better compression than gzip.  Also required for
# mounting XZ-compressed squashfs partitions.
CONFIG_RD_XZ=y

# ADDITIONS: not present in samurai_defconfig
# Ubuntu Touch ships its system image as a SquashFS filesystem.
# All four compression algorithms are enabled because different
# Ubuntu Touch channel releases use different compression.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y

# ADDITION: not present in samurai_defconfig
# autofs4 is required by systemd automount units (the [Automount]
# section of .mount units).  Ubuntu Touch uses this for media mounts.
CONFIG_AUTOFS4_FS=y

# ADDITION: not present in samurai_defconfig
# fanotify is used by systemd's journal for filesystem change
# notifications and by Ubuntu Touch's content-hub for file watching.
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# ============================================================
# SECTION 8 — NLS / CHARACTER SETS
# 1 item: addition
# ============================================================
# CONFIG_NLS_CODEPAGE_437, CONFIG_NLS_ISO8859_1 already in samurai.

# ADDITION: not present in samurai_defconfig
# UTF-8 NLS support is required for correct Unicode filename handling
# on FAT/exFAT volumes and inside Ubuntu Touch's snappy packages.
CONFIG_NLS_UTF8=y

# ============================================================
# SECTION 9 — NETWORKING DIAGNOSTICS
# 3 items: all additions
# ============================================================
# CONFIG_INET_UDP_DIAG, CONFIG_INET_DIAG_DESTROY already in samurai.

# ADDITIONS: not present in samurai_defconfig
# These three diagnostic socket families are required by
# systemd-networkd and ss(8)/ip(8) for network state introspection.
# systemd will log warnings on every boot if they are absent.
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y

# ============================================================
# SECTION 10 — CRYPTO USER-SPACE API
# 2 items: both additions
# ============================================================
# Hardware crypto (QCE, ICE, etc.) already in samurai.

# ADDITIONS: not present in samurai_defconfig
# These user-space API interfaces expose the kernel's crypto
# algorithms to userspace via AF_ALG sockets.  Required by:
#   - openssh (key exchange and encryption)
#   - libssl/libcrypto (TLS stack in Ubuntu Touch)
#   - cryptsetup (LUKS dm-crypt on userdata partition)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# ============================================================
# SECTION 11 — COMPRESSION LIBRARY
# 1 item: addition
# ============================================================

# ADDITION: not present in samurai_defconfig
# XZ decoder library needed by SquashFS XZ decompression (section 7)
# and by XZ-compressed initramfs (RD_XZ above).
CONFIG_XZ_DEC=y

# ============================================================
# SECTION 12 — SECURITY: AppArmor + DEFAULT LSM CHANGE
# 4 items: 2 additions + 2 overrides
# ============================================================
# CONFIG_SECURITY, CONFIG_SECURITY_SELINUX, CONFIG_SECURITY_SMACK,
# CONFIG_HARDENED_USERCOPY, CONFIG_SECCOMP already in samurai.
#
# DESIGN RATIONALE
#   Ubuntu Touch uses AppArmor as its MAC framework — every click
#   package, system service, and Mir client is confined by AppArmor
#   profiles.  SELinux is kept compiled in so the Android container
#   (running inside LXC) can still enforce its own SELinux policies.
#   The two LSMs coexist at compile time; only AppArmor is active by
#   default.  You can switch to SELinux with "security=selinux" on
#   the kernel cmdline if testing the Android container in isolation.

# ADDITION: not present in samurai_defconfig
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y

# ADDITION: not present in samurai_defconfig
# securityfs is required for AppArmor to load, update, and display
# its policy data.  Mounted by systemd at /sys/kernel/security.
# Without this, AppArmor starts in enforce mode but cannot receive
# any policy — all confinement silently fails.
CONFIG_SECURITYFS=y

# OVERRIDE (DEFAULT_SECURITY)
# samurai_defconfig does not explicitly set DEFAULT_SECURITY, which
# means the kernel default applies.  For CONFIG_SECURITY_SELINUX=y
# the kernel default is "selinux".  We override it to "apparmor".
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY="apparmor"

# --- CRITICAL ---
CONFIG_TMPFS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_SECCOMP_FILTER=y

# --- IMPORTANT ---
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_LSM="yama,apparmor,bpf"

# --- OPTIONAL ---
CONFIG_CGROUP_HUGETLB=y
